# Database Configuration
CONNECTION_STRING=mongodb://localhost:27017/myapp

# JWT Configuration
# Use long random strings, e.g. generated with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=24h
# Optional dedicated secrets; each falls back to JWT_SECRET when empty
JWT_VERIFIED_SECRET=
JWT_VERIFIED_EXPIRES_IN=15m
JWT_RESET_PASSWORD_SECRET=
JWT_RESET_PASSWORD_EXPIRES_IN=3m

# Server Configuration
PORT=5005
# Use production in production
NODE_ENV=development

# CORS Configuration (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://myapp.com

# Security Configuration
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5

# DNS Configuration (resolvers used for MongoDB SRV lookups)
DNS_SERVERS=1.1.1.1,8.8.8.8

# Email Configuration (Resend)
EMAIL_ENABLED=false
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=info@myapp.com
EMAIL_FROM_NAME=MyApp
EMAIL_CONTACT_TO=info@myapp.com
COMPANY_LOGO_URL=https://example.com/company-logo.png
APP_URL=https://myapp.com
